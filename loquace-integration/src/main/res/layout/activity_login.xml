<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_primary">

    <!-- Decorative circle top right -->
    <View
        android:id="@+id/circle_top"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:background="@drawable/login_circle_bg"
        android:alpha="0.15"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Decorative circle bottom left -->
    <View
        android:id="@+id/circle_bottom"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/login_circle_bg"
        android:alpha="0.1"
        android:layout_marginBottom="-60dp"
        android:layout_marginStart="-60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Logo + App name -->
    <LinearLayout
        android:id="@+id/logo_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/card">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/loquace_logo"
            android:contentDescription="@string/app_name"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:letterSpacing="0.05"
            android:textStyle="bold"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/login_subtitle"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"/>

    </LinearLayout>

    <!-- Login card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo_section">

        <!-- Domain -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/label_domain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_server_address_label"
            android:textSize="12sp"
            android:textColor="@color/login_label"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/domain_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:boxStrokeColor="@color/login_primary"
            app:hintEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/label_domain"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputDomain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/login_server_address_hint"
                android:inputType="textUri"
                android:paddingLeft="7dp"
                android:textColorHint="@color/login_hint"
                android:background="@drawable/login_card_brackground"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Username -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/label_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/login_username_label"
            android:textSize="12sp"
            android:textColor="@color/login_label"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            app:layout_constraintTop_toBottomOf="@id/domain_layout"
            app:layout_constraintStart_toStartOf="parent"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/username_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:boxStrokeColor="@color/login_primary"
            app:hintEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/label_username"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/login_username_hint"
                android:inputType="text"
                android:paddingLeft="7dp"
                android:textColorHint="@color/login_hint"
                android:background="@drawable/login_card_brackground"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/label_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/login_password_label"
            android:textSize="12sp"
            android:textColor="@color/login_label"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            app:layout_constraintTop_toBottomOf="@id/username_layout"
            app:layout_constraintStart_toStartOf="parent"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/password_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:boxStrokeColor="@color/login_primary"
            app:endIconMode="password_toggle"
            app:hintEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/label_password"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/login_password_hint"
                android:inputType="textPassword"
                android:paddingLeft="7dp"
                android:textColorHint="@color/login_hint"
                android:background="@drawable/login_card_brackground"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Error -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/txtError"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/login_error"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/password_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Login button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogin"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="@string/login_button"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:backgroundTint="@color/login_primary"
            android:stateListAnimator="@null"
            app:layout_constraintTop_toBottomOf="@id/txtError"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Loading -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/login_primary"
            app:layout_constraintTop_toBottomOf="@id/btnLogin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>