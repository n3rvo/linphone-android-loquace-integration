<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="org.linphone.ui.main.dialer.viewmodel.LoquaceDialerViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/color_main1_500">

            <include
                android:id="@+id/top_bar"
                layout="@layout/main_activity_top_bar"
                bind:viewModel="@{viewModel}"
                bind:enableExtraAction="@{false}"
                android:layout_width="0dp"
                android:layout_height="@dimen/top_bar_height"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <View
                android:id="@+id/shadow_effect"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="@dimen/top_bar_shadow_height"
                android:background="@drawable/shape_squircle_white_r20_top_shadow"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/top_bar_height"
                android:background="@drawable/shape_squircle_white_r20_top_background"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/bottom_nav_bar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/number_display"
                    style="@style/default_text_style"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginEnd="32dp"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/shape_squircle_gray_100_background"
                    android:text="@{viewModel.numberInput}"
                    android:textSize="32sp"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:textColor="?attr/color_main2_800"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/dialpad_grid"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.gridlayout.widget.GridLayout
                    android:id="@+id/dialpad_grid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:columnCount="3"
                    app:rowCount="4"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/call_button"
                    app:layout_constraintTop_toBottomOf="@id/number_display"
                    app:layout_constraintVertical_chainStyle="packed">

                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="0dp"
                        android:layout_height="@dimen/call_button_size"
                        android:text="1"
                        android:textSize="24sp"
                        android:onClick="@{() -> viewModel.onDigitClicked(`1`)}"
                        android:background="@drawable/squircle_transparent_button_background"
                        app:layout_columnWeight="1" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="0dp"
                        android:layout_height="@dimen/call_button_size"
                        android:text="2"
                        android:textSize="24sp"
                        android:onClick="@{() -> viewModel.onDigitClicked(`2`)}"
                        android:background="@drawable/squircle_transparent_button_background"
                        app:layout_columnWeight="1" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="0dp"
                        android:layout_height="@dimen/call_button_size"
                        android:text="3"
                        android:textSize="24sp"
                        android:onClick="@{() -> viewModel.onDigitClicked(`3`)}"
                        android:background="@drawable/squircle_transparent_button_background"
                        app:layout_columnWeight="1" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="0dp"
                        android:layout_height="@dimen/call_button_size"
                        android:text="4"
                        android:textSize="24sp"
                        android:onClick="@{() -> viewModel.onDigitClicked(`4`)}"
                        android:background="@drawable/squircle_transparent_button_background"
                        app:layout_columnWeight="1" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="0dp"
                        android:layout_height="@dimen/call_button_size"
                        android:text="5"
                        android:textSize="24sp"
                        android:onClick="@{() -> viewModel.onDigitClicked(`5`)}"
                        android:background="@drawable/squircle_transparent_button_background"
                        app:layout_columnWeight="1" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="0dp"
                        android:layout_height="@dimen/call_button_size"
                        android:text="6"
                        android:textSize="24sp"
                        android:onClick="@{() -> viewModel.onDigitClicked(`6`)}"
                        android:background="@drawable/squircle_transparent_button_background"
                        app:layout_columnWeight="1" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="0dp"
                        android:layout_height="@dimen/call_button_size"
                        android:text="7"
                        android:textSize="24sp"
                        android:onClick="@{() -> viewModel.onDigitClicked(`7`)}"
                        android:background="@drawable/squircle_transparent_button_background"
                        app:layout_columnWeight="1" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="0dp"
                        android:layout_height="@dimen/call_button_size"
                        android:text="8"
                        android:textSize="24sp"
                        android:onClick="@{() -> viewModel.onDigitClicked(`8`)}"
                        android:background="@drawable/squircle_transparent_button_background"
                        app:layout_columnWeight="1" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="0dp"
                        android:layout_height="@dimen/call_button_size"
                        android:text="9"
                        android:textSize="24sp"
                        android:onClick="@{() -> viewModel.onDigitClicked(`9`)}"
                        android:background="@drawable/squircle_transparent_button_background"
                        app:layout_columnWeight="1" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="0dp"
                        android:layout_height="@dimen/call_button_size"
                        android:text="*"
                        android:textSize="24sp"
                        android:onClick="@{() -> viewModel.onDigitClicked(`*`)}"
                        android:background="@drawable/squircle_transparent_button_background"
                        app:layout_columnWeight="1" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="0dp"
                        android:layout_height="@dimen/call_button_size"
                        android:text="0"
                        android:textSize="24sp"
                        android:onClick="@{() -> viewModel.onDigitClicked(`0`)}"
                        android:onLongClick="@{() -> viewModel.onZeroLongClicked()}"
                        android:background="@drawable/squircle_transparent_button_background"
                        app:layout_columnWeight="1" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:layout_width="0dp"
                        android:layout_height="@dimen/call_button_size"
                        android:text="#"
                        android:textSize="24sp"
                        android:onClick="@{() -> viewModel.onDigitClicked(`#`)}"
                        android:background="@drawable/squircle_transparent_button_background"
                        app:layout_columnWeight="1" />

                </androidx.gridlayout.widget.GridLayout>

                <ImageView
                    android:id="@+id/call_button"
                    android:layout_width="200dp"
                    android:layout_height="@dimen/call_button_size"
                    android:layout_marginStart="103dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="32dp"
                    android:padding="15dp"
                    android:src="@drawable/phone"
                    android:background="@drawable/squircle_green_button_background"
                    android:contentDescription="@string/content_description_call_start"
                    android:onClick="@{() -> viewModel.onCallClicked()}"
                    app:tint="@color/bc_white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/backspace_button"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/dialpad_grid"/>

                <ImageView
                    android:id="@+id/backspace_button"
                    android:layout_width="@dimen/call_button_size"
                    android:layout_height="@dimen/call_button_size"
                    android:layout_marginEnd="32dp"
                    android:padding="15dp"
                    android:src="@drawable/backspace_fill"
                    android:background="@drawable/in_call_numpad_button_background"
                    android:contentDescription="@string/content_description_erase_last_input"
                    android:onClick="@{() -> viewModel.onBackspaceClicked()}"
                    android:onLongClick="@{() -> viewModel.onBackspaceLongClicked()}"
                    app:tint="@color/bc_white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/call_button"
                    app:layout_constraintBottom_toBottomOf="@id/call_button"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <include
                android:id="@+id/bottom_nav_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/bottom_nav_bar"
                bind:viewModel="@{viewModel}"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</layout>